ℛ≡{"0001":"module(\"rinkvt.lkvexa.loopback_leases\")","0002":"learn(\"component\",literal(\"photon/device.go, photon/loopback.go, photon/host.go (leaseThisLaptop), rinkvt-photon leases\"))","0003":"learn(\"contract\",literal(\"every laptop keeps one 127.x.y.z address for good: the address is leased to the laptop's device key, pinned in its device file, and asked for in every lease table the laptop meets; a table grants it unless another laptop holds it there, so no table ever gives one address to two laptops; a fleet register that every laptop shares makes the addresses unique everywhere; a lease is written, synced and sealed before the address is used\"))","0004":"learn(\"device_key\",literal(\"device: followed by the first 32 hex digits of HMAC-SHA-256 with the key 'RINK-VT device 1' over the trimmed, lower-cased machine identifier; the identifier itself is never stored; a computer without one gets a random 128-bit key\"))","0005":"learn(\"machine_identifier\",literal(\"{\\\"windows\\\":\\\"HKLM\\\\\\\\SOFTWARE\\\\\\\\Microsoft\\\\\\\\Cryptography\\\\\\\\MachineGuid\\\",\\\"macos\\\":\\\"IOPlatformUUID\\\",\\\"linux\\\":\\\"/etc/machine-id or /var/lib/dbus/machine-id\\\"}\"))","0006":"learn(\"device_file\",literal(\"{\\\"windows\\\":\\\"%LOCALAPPDATA%\\\\\\\\RINK-VT\\\\\\\\device.json\\\",\\\"macos\\\":\\\"~/Library/Application Support/RINK-VT/device.json\\\",\\\"linux\\\":\\\"$XDG_DATA_HOME/rink-vt/device.json\\\",\\\"override\\\":\\\"RINKVT_DEVICE_FILE or --device-file\\\"}\"))","0007":"learn(\"pool\",literal(\"127.16.0.0/12\"))","0008":"learn(\"capacity\",literal(\"1040384\"))","0009":"learn(\"slot\",literal(\"the first 16 hex digits of SHA-256('RINK-VT loopback 1' NUL key), modulo the capacity; then linear probing over host addresses .1 to .254\"))","0010":"learn(\"keys\",literal(\"a device key; or, as the reference edition keys its clients, the canonical text of an IP address (RFC 5952; an IPv4-mapped IPv6 address is its IPv4 address)\"))","0011":"learn(\"file_format\",literal(\"a header line '# RINK-VT loopback leases · format 2 · pool P · ipv6 /N', then one line per lease: address, key, time and a 16-digit seal; a format 1 table (IP keys only) is read, and upgraded once, every line kept, when it receives a device key\"))","0012":"learn(\"fleet_register\",literal(\"a lease table on a share or a removable disk that every laptop of a club or league uses (--fleet, remembered once given); never created where its folder is missing; when it cannot be reached, the pinned address is used\"))","0013":"learn(\"refusals\",literal(\"[\\\"an edited or damaged line\\\",\\\"a second lease for one key or one address\\\",\\\"a pool or IPv6 prefix other than the file's\\\",\\\"a device key in a format 1 table\\\",\\\"a full pool\\\"]\"))","0014":"learn(\"ja_contract\",literal(\"contracts/ja/rinkvt_loopback.ja\"))","0015":"learn(\"maturity\",literal(\"OPERATIONAL\"))","0016":"learn(\"evidence\",literal(\"[\\\"photon/loopback_test.go\\\",\\\"photon/device_test.go\\\",\\\"photon/browser_test.go\\\"]\"))"},
