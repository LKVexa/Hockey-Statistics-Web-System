ℛ≡{"0001":"module(\"rinkvt.lkvexa.league_store\")","0002":"learn(\"component\",literal(\"photon/store.go\"))","0003":"learn(\"contract\",literal(\"a commit carries the registry text (optional), the registry seal the window last saw, and the new ledger entry pairs of each game; it is refused unless that seal is current (409), every stored game is kept with its uuid, each batch starts where its ledger ends, and every pair passes the engine's own seals; the answer is sent only after the registry and the ledger lines are synced to disk\"))","0004":"learn(\"files\",literal(\"[\\\"league/registry/registry.json\\\",\\\"league/registry/registry.sha256\\\",\\\"league/ledger/<key>-<uuid8>.jsonl\\\",\\\"events.jsonl\\\"]\"))","0005":"learn(\"seals\",literal(\"{\\\"registry\\\":\\\"SHA-256 of registry.json, kept in registry.sha256 and replaced through registry.sha256.new and two renames\\\",\\\"ledger\\\":\\\"line n carries prev, the hash of line n-1, and hash = SHA-256(prev LF frame-hex meta-hex LF n); the first prev is SHA-256('RINK-VT ledger 1' NUL key NUL uuid)\\\",\\\"frame\\\":\\\"CRC-32C of bytes 0-59, big-endian at bytes 60-63; bytes 32-35 are the first four bytes of the game's uuid\\\",\\\"meta\\\":\\\"magic CMT1 (0x31544D43, little-endian) at bytes 0-3; CRC-32C of bytes 0-59, little-endian at bytes 60-63\\\"}\"))","0006":"learn(\"recovery\",literal(\"a last line without its newline was never acknowledged: opening the league drops it; a verification reports it and repairs nothing\"))","0007":"learn(\"limits\",literal(\"{\\\"registry_bytes\\\":16777216,\\\"pairs_per_game\\\":40000}\"))","0008":"learn(\"ja_contract\",literal(\"contracts/ja/rinkvt_store.ja\"))","0009":"learn(\"maturity\",literal(\"OPERATIONAL\"))","0010":"learn(\"evidence\",literal(\"[\\\"photon/store_test.go\\\",\\\"photon/server_test.go\\\",\\\"photon/browser_test.go\\\"]\"))"},
