ℛ≡{"0001":"module(\"rinkvt.lkvexa.engine\")","0002":"learn(\"component\",literal(\"engine/ (32 modules and 3 data tables: the reference edition's engine 2.5.0-rinkvt.1 with the start frame of this release), ui/loader.js, ui/app.js\"))","0003":"learn(\"contract\",literal(\"the command language, frames, game actor, models, roster importer and HK001 run in the renderer as the reference edition runs them; the window sends the host every change a command made and shows the command's result only after the host has it on disk; when the host refuses, the window loads the league again\"))","0004":"learn(\"engine_version\",literal(\"2.5.0-rinkvt.1+startframe\"))","0005":"learn(\"start_frame\",literal(\"START is the game's start frame, a !CLK frame with the action byte 66 (B): the opening faceoff. In a game created under the start-frame rule, as every game created in this edition is, the clock runs only after it and GO is refused until then; a game created by an earlier build starts with its first GO, so its ledger replays unchanged\"))","0006":"learn(\"ja_contract\",literal(\"contracts/ja/rinkvt_frame.ja\"))","0007":"learn(\"maturity\",literal(\"OPERATIONAL\"))","0008":"learn(\"evidence\",literal(\"[\\\"tests/test_browser.py\\\",\\\"tests/test_store.py\\\"]\"))","0009":"learn(\"scope_limit\",literal(\"the engine's own test suite belongs to the reference edition (Node.js), whose 78 engine tests pass on this engine; this edition exercises the engine through its browser tests\"))"},
