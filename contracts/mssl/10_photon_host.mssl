μ≡{"learn.component":"photon/rinkvt.py, photon/host/server.py","learn.contract":"serves the workbench and a JSON API on this computer's static loopback address only; a request whose Host header does not name that address and port is refused (421); every /api route except /api/health needs the per-launch X-VEC1-Token (403); a change is accepted only as application/json from the same origin (415, 403); a body is at most 32 MiB and never chunked (413, 411)","learn.interfaces":["GET /","GET /workbench.js","GET /workbench.css","GET /api/health","GET /api/edition","GET /api/league","GET /api/ledgers?sha=","GET /api/verify","POST /api/commit","POST /api/shutdown"],"learn.invariants":["one host per data folder, held by an exclusive lock file","the code of the release matches RELEASE_MANIFEST.json before anything else is opened; otherwise the start is refused with exit code 4","requests are not logged; the host's event ledger records starts, commits and stops","the laptop is identified by its device key, derived from the machine identifier, which is never stored or shown","every response carries a Content-Security-Policy of default-src 'self' with no inline script or style"],"learn.state_model":["checking the release","taking the data folder","opening the league","identifying this laptop","leasing its loopback address","listening","stopped"],"learn.exit_codes":{"0":"stopped","1":"verification failed","2":"usage","4":"release integrity","5":"data folder in use","6":"the league cannot be opened","7":"device file, loopback lease or listener"},"learn.ja_contract":"contracts/ja/rinkvt_host.ja","learn.maturity":"OPERATIONAL","learn.evidence":["tests/test_server.py","tests/test_browser.py"]},
