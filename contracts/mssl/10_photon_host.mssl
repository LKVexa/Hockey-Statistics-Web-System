ℛ≡{"0001":"module(\"rinkvt.lkvexa.photon_host\")","0002":"learn(\"component\",literal(\"photon/rinkvt.py, photon/host/server.py\"))","0003":"learn(\"contract\",literal(\"serves the workbench and a JSON API on this computer's static loopback address only; a request whose Host header does not name that address and port is refused (421); every /api route except /api/health needs the per-launch X-VEC1-Token (403); a change is accepted only as application/json from the same origin (415, 403); a body is at most 32 MiB and never chunked (413, 411)\"))","0004":"learn(\"interfaces\",literal(\"[\\\"GET /\\\",\\\"GET /workbench.js\\\",\\\"GET /workbench.css\\\",\\\"GET /api/health\\\",\\\"GET /api/edition\\\",\\\"GET /api/league\\\",\\\"GET /api/ledgers?sha=\\\",\\\"GET /api/verify\\\",\\\"POST /api/commit\\\",\\\"POST /api/shutdown\\\"]\"))","0005":"learn(\"invariants\",literal(\"[\\\"one host per data folder, held by an exclusive lock file\\\",\\\"the code of the release matches RELEASE_MANIFEST.json before anything else is opened; otherwise the start is refused with exit code 4\\\",\\\"requests are not logged; the host's event ledger records starts, commits and stops\\\",\\\"the laptop is identified by its device key, derived from the machine identifier, which is never stored or shown\\\",\\\"every response carries a Content-Security-Policy of default-src 'self' with no inline script or style\\\"]\"))","0006":"learn(\"state_model\",literal(\"[\\\"checking the release\\\",\\\"taking the data folder\\\",\\\"opening the league\\\",\\\"identifying this laptop\\\",\\\"leasing its loopback address\\\",\\\"listening\\\",\\\"stopped\\\"]\"))","0007":"learn(\"exit_codes\",literal(\"{\\\"0\\\":\\\"stopped\\\",\\\"1\\\":\\\"verification failed\\\",\\\"2\\\":\\\"usage\\\",\\\"4\\\":\\\"release integrity\\\",\\\"5\\\":\\\"data folder in use\\\",\\\"6\\\":\\\"the league cannot be opened\\\",\\\"7\\\":\\\"device file, loopback lease or listener\\\"}\"))","0008":"learn(\"ja_contract\",literal(\"contracts/ja/rinkvt_host.ja\"))","0009":"learn(\"maturity\",literal(\"OPERATIONAL\"))","0010":"learn(\"evidence\",literal(\"[\\\"tests/test_server.py\\\",\\\"tests/test_browser.py\\\"]\"))"},
